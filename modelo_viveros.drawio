        <mxCell id="text3" value="PEDIDO: atributos en la página 4." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="706.0" y="1311.7" width="2068.0" height="26.599999999999998" as="geometry" />
        </mxCell>
        <mxCell id="text4" value="Regla temporal: un empleado nunca tiene puestos simultáneos en viveros distintos." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="193.2" width="2068.0" height="33.599999999999994" as="geometry" />
        </mxCell>
        <mxCell id="text5" value="Cambiar de zona o tarea crea otro puesto. Los registros anteriores se conservan." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="239.6" width="2068.0" height="30.799999999999997" as="geometry" />
        </mxCell>
        <mxCell id="text6" value="Las fechas del pedido y del objetivo deben quedar dentro del intervalo del puesto." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="284.6" width="2068.0" height="30.799999999999997" as="geometry" />
        </mxCell>
        <mxCell id="text7" value="Intervalos [inicio, fin); fecha_fin vacía indica un puesto abierto." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="329.6" width="2068.0" height="30.799999999999997" as="geometry" />
        </mxCell>
        <mxCell id="text8" value="Cardinalidad junto a una entidad = participaciones de cada instancia de esa entidad." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="1546.7" width="2068.0" height="26.599999999999998" as="geometry" />
        </mxCell>
        <mxCell id="text9" value="Subrayado: clave · Óvalo discontinuo: derivado · Doble borde: entidad débil / relación identificadora." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="1577.4" width="2068.0" height="25.2" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
