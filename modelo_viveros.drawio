        <mxCell id="text0" value="Pedidos y Tajinaste Plus" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=40;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="36.0" width="2068.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="Pedidos desde la fecha de ingreso · Bonificación única por cliente y mes · Importes de venta históricos" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="96.3" width="2068.0" height="29.4" as="geometry" />
        </mxCell>
        <mxCell id="text2" value="PUESTO: atributos en la página 3." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="-704.0" y="821.7" width="2068.0" height="26.599999999999998" as="geometry" />
        </mxCell>
        <mxCell id="text3" value="PRODUCTO: atributos en la página 2." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="716.0" y="821.7" width="2068.0" height="26.599999999999998" as="geometry" />
        </mxCell>
        <mxCell id="text4" value="Clave de la bonificación: cliente + periodo; periodo es una clave parcial (subrayado discontinuo)." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="1085.3" width="2068.0" height="29.4" as="geometry" />
        </mxCell>
        <mxCell id="text5" value="total = Σ cantidad × precio_unitario · volumen_compras = Σ total de los pedidos del mes" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="1125.3" width="2068.0" height="29.4" as="geometry" />
        </mxCell>
        <mxCell id="text6" value="Cardinalidad junto a una entidad = participaciones de cada instancia de esa entidad." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="1176.7" width="2068.0" height="26.599999999999998" as="geometry" />
        </mxCell>
        <mxCell id="text7" value="Subrayado: clave · Óvalo discontinuo: derivado · Doble borde: entidad débil / relación identificadora." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="1207.4" width="2068.0" height="25.2" as="geometry" />
        </mxCell>
