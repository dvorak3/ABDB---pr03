        </mxCell>
        <mxCell id="text1" value="Vista general: las tres páginas siguientes desarrollan los atributos del mismo modelo." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="96.3" width="2068.0" height="29.4" as="geometry" />
        </mxCell>
        <mxCell id="text2" value="Cada pedido → un puesto → un empleado responsable y una zona histórica." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="1534.6" width="2068.0" height="30.799999999999997" as="geometry" />
        </mxCell>
        <mxCell id="text3" value="Cardinalidad junto a una entidad = participaciones de cada instancia de esa entidad." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="1586.7" width="2068.0" height="26.599999999999998" as="geometry" />
        </mxCell>
        <mxCell id="text4" value="Subrayado: clave · Óvalo discontinuo: derivado · Doble borde: entidad débil / relación identificadora." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
